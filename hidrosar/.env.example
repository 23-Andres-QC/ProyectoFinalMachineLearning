# Copia este archivo como .env y completa los valores. El .env no se sube a git.

# Base de datos (PostgreSQL + PostGIS)
POSTGRES_PASSWORD=cambia-esta-clave

# Firma de las sesiones: 32 caracteres o más, al azar
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-al-azar

# Administrador que se crea la primera vez que arranca el backend
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@hidrosar.local
ADMIN_PASSWORD=cambia-esta-clave

# Cuenta gratuita de NASA Earthdata (https://urs.earthdata.nasa.gov), para bajar el recorte de NISAR
EARTHDATA_USER=
EARTHDATA_PASSWORD=

# Modelo predeterminado: archivo dentro de hidrosar-modelo/modelos/ (de las carpetas Vol1 o ModelosVol3, ver su LEEME)
MODELO_PT=vol3/unet_efficientnet-b0.pt

# Opcionales
ZONA_HORARIA=America/Lima
MAX_AREA_KM2=150
PUERTO_WEB=8080
# true solo si la web se sirve con HTTPS
COOKIE_SEGURA=false
